@startuml BuildFlow_UseCase_Diagram
title BuildFlow - System Use Case Diagram (Stakeholders & Functional Use Cases)
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Project Owner" as Owner <<primary_actor>>
actor "Project Manager" as PM <<primary_actor>>
actor "Architect" as Arch <<primary_actor>>
actor "Structural Engineer (PE)" as Eng <<primary_actor>>
actor "General Contractor" as Cont <<primary_actor>>
actor "Site Supervisor" as Site <<primary_actor>>
actor "Material Supplier" as Supp <<primary_actor>>
actor "Safety Inspector" as Insp <<primary_actor>>

rectangle "BUILDFlow Construction Collaboration Platform" {
  usecase "UC-01: Create & View Projects" as UC1
  usecase "UC-02: Manage Milestone Tasks & Kanban" as UC2
  usecase "UC-03: View Schedule & Gantt Dependencies" as UC3
  usecase "UC-04: Upload BIM/CAD Drawings" as UC4
  usecase "UC-05: Review & Certify Blueprints" as UC5
  usecase "UC-06: Request & Track Materials" as UC6
  usecase "UC-07: Update Supply Chain Status" as UC7
  usecase "UC-08: Record Safety & Quality Audits" as UC8
  usecase "UC-09: Log Site Issues & Hazards" as UC9
  usecase "UC-10: View Executive KPIs & Export Reports" as UC10
  usecase "UC-11: Inspect Immutable Audit Log" as UC11
}

note right of UC5
  Engineering Note:
  Requires Structural PE Certification
  and NFPA-90A Code Compliance Check.
end note

note right of UC7
  Logistics Note:
  Triggers immediate alert banner if
  shipment status is flagged DELAYED.
end note

Owner --> UC1
Owner --> UC10

PM --> UC1
PM --> UC2
PM --> UC3
PM --> UC6
PM --> UC10
PM --> UC11

Arch --> UC4
Arch --> UC5

Eng --> UC5
Eng --> UC8

Cont --> UC2
Cont --> UC3
Cont --> UC6
Cont --> UC9

Site --> UC2
Site --> UC8
Site --> UC9

Supp --> UC7

Insp --> UC8
Insp --> UC9

UC2 ..> UC11 : <<include>>
UC5 ..> UC11 : <<include>>
UC8 ..> UC11 : <<include>>

UC9 .> UC6 : <<extend>>
UC9 .> UC8 : <<extend>>

@enduml
