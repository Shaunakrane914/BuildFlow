@startuml BuildFlow_Component_Diagram
title BuildFlow - Software Component Diagram (Architectural Modules & Subsystems)
skinparam componentStyle uml2
skinparam shadowing false

package "Frontend Client Application (SPA)" <<subsystem>> {
  [React UI Layer] as UI
  [Auth & Role Context] as Auth
  [Project & KPI Context] as ProjCtx
  [Kanban Task Component] as Kanban
  [Design Review Modal] as DesignUI
  [Material Supply Grid] as MatUI
  [Axios REST Client] as Axios
}

interface "IRestApi" as IRestApi
interface "IDatabase" as IDatabase
interface "IAuditLogger" as IAuditLogger

package "Backend REST API Server" <<subsystem>> {
  [Express Router /api] as Router
  [AuthController] as AuthCtrl
  [ProjectController] as ProjCtrl
  [TaskController] as TaskCtrl
  [DesignController] as DesignCtrl
  [MaterialController] as MatCtrl
  [InspectionController] as InspCtrl
  [DashboardController] as DashCtrl
  [ActivityAuditService] as AuditSvc <<service>>
  [Prisma ORM Client] as Prisma <<service>>
}

database "Data Storage" <<database>> {
  [SQLite Relational DB (dev.db)] as DB
}

package "External DevOps & Collaboration Services" <<subsystem>> {
  [Slack Webhook Service] as Slack
  [GitHub Actions CI/CD] as CI
}

Router - IRestApi
Prisma - IDatabase
AuditSvc - IAuditLogger

Axios ..> IRestApi : <<use>>

UI ..> Axios
Kanban ..> Axios
DesignUI ..> Axios
MatUI ..> Axios

Router --> AuthCtrl
Router --> ProjCtrl
Router --> TaskCtrl
Router --> DesignCtrl
Router --> MatCtrl
Router --> InspCtrl
Router --> DashCtrl

TaskCtrl ..> IAuditLogger
DesignCtrl ..> IAuditLogger
MatCtrl ..> IAuditLogger

AuthCtrl ..> Prisma
ProjCtrl ..> Prisma
TaskCtrl ..> Prisma
DesignCtrl ..> Prisma
MatCtrl ..> Prisma
InspCtrl ..> Prisma
DashCtrl ..> Prisma

Prisma ..> IDatabase

AuditSvc ..> Slack
CI ..> Prisma

@enduml
