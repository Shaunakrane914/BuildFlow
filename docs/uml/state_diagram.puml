@startuml BuildFlow_State_Diagram
skinparam state {
  BackgroundColor White
  BorderColor DarkSlateGray
  ArrowColor Black
}

state "Task Lifecycle" as TaskLifecycle {
  [*] --> BACKLOG : Work package drafted
  BACKLOG --> TODO : Scheduled in Milestone
  TODO --> IN_PROGRESS : Contractor begins work
  IN_PROGRESS --> IN_REVIEW : Crew finishes, awaiting audit
  IN_REVIEW --> DONE : Verified & passed QA
  IN_REVIEW --> IN_PROGRESS : Non-conformance rework
  DONE --> [*]
}

state "Material Supply Chain Lifecycle" as MaterialLifecycle {
  [*] --> REQUESTED : Batch order submitted
  REQUESTED --> ORDERED : Purchase order approved
  ORDERED --> IN_TRANSIT : Dispatched from warehouse
  IN_TRANSIT --> DELIVERED : Offloaded at site
  IN_TRANSIT --> DELAYED : Customs / Port hold
  DELAYED --> IN_TRANSIT : Cleared & resumed transit
  DELIVERED --> [*]
}

@enduml
